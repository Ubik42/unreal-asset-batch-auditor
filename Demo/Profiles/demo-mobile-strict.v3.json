{
  "schema_version": "unreal-static-mesh-profile@3.0.0",
  "profile_id": "demo-mobile-strict-v3",
  "profile_version": "3.0.0",
  "description": "Recording demo training profile with strict mobile geometry, material, texture, collision, and Lightmap budgets.",
  "rules": {
    "triangle_budget": { "enabled": true, "max_lod0": 500, "severity": "error" },
    "vertex_budget": { "enabled": true, "max_lod0": 400, "severity": "error" },
    "material_slots": { "enabled": true, "max_count": 1, "severity": "warning" },
    "lod_count": { "enabled": true, "min_count": 2, "severity": "warning" },
    "nanite": { "enabled": true, "expected": "enabled", "severity": "warning" },
    "simple_collision": { "enabled": true, "min_primitive_count": 1, "allow_complex_as_simple": false, "severity": "error" },
    "lightmap_uv": { "enabled": true, "required": true, "min_uv_channel_count": 2, "severity": "error" },
    "lightmap_resolution": { "enabled": true, "min_resolution": 64, "severity": "warning" },
    "object_name": { "enabled": true, "required_prefixes": ["SM_UABA_"], "pattern": "^SM_UABA_[0-9]{2}_[A-Za-z0-9_]+$", "severity": "error" },
    "package_path": { "enabled": true, "allowed_roots": ["/Game/UABADemo"], "forbidden_segments": ["Developers", "Temp"], "severity": "error" },
    "missing_materials": { "enabled": true, "max_missing_slots": 0, "severity": "error" },
    "unique_materials": { "enabled": true, "max_count": 1, "severity": "error" },
    "texture_dependencies": { "enabled": true, "max_count": 4, "severity": "warning" },
    "texture_dimension": { "enabled": true, "max_size": 1024, "severity": "warning" }
  }
}
