{
  "schema_version": "unreal-static-mesh-profile@1.0.0",
  "profile_id": "demo-mobile-strict",
  "profile_version": "1.0.0",
  "description": "演示用移动端严格规则：用于放大同一批资产在不同项目政策下的差异。数值为模拟项目数据。",
  "rules": {
    "triangle_budget": { "enabled": true, "max_lod0": 500, "severity": "error" },
    "vertex_budget": { "enabled": true, "max_lod0": 400, "severity": "error" },
    "material_slots": { "enabled": true, "max_count": 1, "severity": "warning" },
    "lod_count": { "enabled": true, "min_count": 2, "severity": "warning" },
    "nanite": { "enabled": true, "expected": "enabled", "severity": "warning" }
  }
}
