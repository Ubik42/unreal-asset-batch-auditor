{
  "schema_version": "unreal-static-mesh-profile@2.0.0",
  "profile_id": "demo-review-lenient-v2",
  "profile_version": "2.0.0",
  "description": "演示用宽松复核规则：碰撞与 Lightmap 仅作信息提示。数值为模拟项目数据。",
  "rules": {
    "triangle_budget": { "enabled": true, "max_lod0": 10000, "severity": "error" },
    "vertex_budget": { "enabled": true, "max_lod0": 7000, "severity": "error" },
    "material_slots": { "enabled": true, "max_count": 4, "severity": "warning" },
    "lod_count": { "enabled": true, "min_count": 1, "severity": "warning" },
    "nanite": { "enabled": true, "expected": "any", "severity": "warning" },
    "simple_collision": { "enabled": false, "min_primitive_count": 0, "allow_complex_as_simple": true, "severity": "info" },
    "lightmap_uv": { "enabled": true, "required": true, "min_uv_channel_count": 1, "severity": "info" },
    "lightmap_resolution": { "enabled": true, "min_resolution": 16, "severity": "info" }
  }
}
