{
  "schema_version": "unreal-static-mesh-profile@3.0.0",
  "profile_id": "host-material-evidence-v3",
  "profile_version": "3.0.0",
  "description": "宿主证据专用模拟规则：用低纹理阈值稳定展示材质依赖问题，不代表生产项目标准。",
  "rules": {
    "triangle_budget": { "enabled": false, "max_lod0": 1000000, "severity": "info" },
    "vertex_budget": { "enabled": false, "max_lod0": 1000000, "severity": "info" },
    "material_slots": { "enabled": false, "max_count": 16, "severity": "info" },
    "lod_count": { "enabled": false, "min_count": 1, "severity": "info" },
    "nanite": { "enabled": false, "expected": "any", "severity": "info" },
    "simple_collision": { "enabled": false, "min_primitive_count": 0, "allow_complex_as_simple": true, "severity": "info" },
    "lightmap_uv": { "enabled": false, "required": false, "min_uv_channel_count": 1, "severity": "info" },
    "lightmap_resolution": { "enabled": false, "min_resolution": 1, "severity": "info" },
    "object_name": { "enabled": false, "required_prefixes": ["SM_"], "pattern": null, "severity": "info" },
    "package_path": { "enabled": false, "allowed_roots": ["/Engine"], "forbidden_segments": [], "severity": "info" },
    "missing_materials": { "enabled": true, "max_missing_slots": 0, "severity": "error" },
    "unique_materials": { "enabled": false, "max_count": 16, "severity": "info" },
    "texture_dependencies": { "enabled": true, "max_count": 1, "severity": "warning" },
    "texture_dimension": { "enabled": true, "max_size": 256, "severity": "warning" }
  }
}
