{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unreal-asset-audit-report@1.0.0",
  "title": "Unreal Asset Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "created_at", "profile_id", "profile_version", "profile_schema_version", "collection_mode", "real_unreal_validation", "host_engine_version", "asset_count", "issue_count", "collection_failure_count", "issues", "evidence", "collection_failures"],
  "properties": {
    "schema_version": { "const": "unreal-asset-audit@1.0.0" },
    "report_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "profile_schema_version": { "const": "unreal-static-mesh-profile@1.0.0" },
    "collection_mode": { "enum": ["offline_fixture", "unreal_editor"] },
    "real_unreal_validation": { "type": "boolean" },
    "host_engine_version": { "type": ["string", "null"] },
    "asset_count": { "type": "integer", "minimum": 0 },
    "issue_count": { "type": "integer", "minimum": 0 },
    "collection_failure_count": { "type": "integer", "minimum": 0 },
    "requested_asset_count": { "type": "integer", "minimum": 0 },
    "processed_asset_count": { "type": "integer", "minimum": 0 },
    "cancelled_asset_count": { "type": "integer", "minimum": 0 },
    "completed_batch_count": { "type": "integer", "minimum": 0 },
    "batch_size": { "type": ["integer", "null"], "minimum": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_path", "asset_name", "lods", "material_slot_count", "nanite_enabled"],
        "properties": {
          "asset_path": { "type": "string", "minLength": 1 },
          "asset_name": { "type": "string", "minLength": 1 },
          "lods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "triangles", "vertices"],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "triangles": { "type": "integer", "minimum": 0 },
                "vertices": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "material_slot_count": { "type": "integer", "minimum": 0 },
          "nanite_enabled": { "type": "boolean" }
        }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "issue.v1.schema.json" } },
    "evidence": { "type": "array", "items": { "$ref": "evidence.v1.schema.json" } },
    "collection_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "asset_path", "code", "message", "collector"],
        "properties": {
          "schema_version": { "const": "unreal-asset-audit@1.0.0" },
          "asset_path": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "collector": { "enum": ["offline_fixture", "unreal_editor"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "collection_mode": { "const": "offline_fixture" } } },
      "then": {
        "properties": {
          "real_unreal_validation": { "const": false },
          "host_engine_version": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "real_unreal_validation": { "const": true } } },
      "then": { "properties": { "host_engine_version": { "type": "string", "minLength": 1 } } }
    }
  ]
}
