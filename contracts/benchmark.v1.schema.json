{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unreal-readonly-collector-benchmark@1.0.0",
  "title": "Unreal Read-only Collector Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "engine_version", "collection_mode", "dataset", "configuration", "runs", "summary", "integrity", "limitations"],
  "properties": {
    "schema_version": { "const": "unreal-readonly-collector-benchmark@1.0.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "engine_version": { "type": "string", "minLength": 1 },
    "collection_mode": { "const": "unreal_editor" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selection", "requested_count", "asset_paths"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "selection": { "type": "string", "minLength": 1 },
        "requested_count": { "type": "integer", "minimum": 1 },
        "asset_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_size", "warmup_runs", "repetitions", "timer"],
      "properties": {
        "batch_size": { "type": "integer", "minimum": 1 },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "timer": { "const": "python.time.perf_counter around one C++ batch call" }
      }
    },
    "runs": { "type": "array", "minItems": 1 },
    "summary": { "type": "object" },
    "integrity": { "type": "object" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
