{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unreal-static-mesh-profile@1.0.0",
  "title": "Unreal Static Mesh Audit Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "rules"],
  "properties": {
    "schema_version": { "const": "unreal-static-mesh-profile@1.0.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangle_budget", "vertex_budget", "material_slots", "lod_count", "nanite"],
      "properties": {
        "triangle_budget": { "$ref": "#/$defs/lod0Limit" },
        "vertex_budget": { "$ref": "#/$defs/lod0Limit" },
        "material_slots": { "$ref": "#/$defs/countLimit" },
        "lod_count": { "$ref": "#/$defs/countMinimum" },
        "nanite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "expected", "severity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "expected": { "enum": ["enabled", "disabled", "any"] },
            "severity": { "$ref": "#/$defs/severity" }
          }
        }
      }
    }
  },
  "$defs": {
    "severity": { "enum": ["info", "warning", "error"] },
    "lod0Limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_lod0", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_lod0": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "#/$defs/severity" }
      }
    },
    "countLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_count", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_count": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "#/$defs/severity" }
      }
    },
    "countMinimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "min_count", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "min_count": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "#/$defs/severity" }
      }
    }
  }
}
