{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-pipeline.local/contracts/unreal-material-profile.v1.schema.json",
  "title": "Unreal Material Interface 审计 Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "description", "rules"],
  "properties": {
    "schema_version": {"const": "unreal-material-profile@1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_domains", "allowed_blend_modes", "two_sided", "instance_parent", "parent_depth", "texture_dependencies", "texture_dimension"],
      "properties": {
        "allowed_domains": {"$ref": "#/$defs/allowedValuesRule"},
        "allowed_blend_modes": {"$ref": "#/$defs/allowedValuesRule"},
        "two_sided": {"$ref": "#/$defs/stateRule"},
        "instance_parent": {"$ref": "#/$defs/booleanRule"},
        "parent_depth": {"$ref": "#/$defs/maximumRule"},
        "texture_dependencies": {"$ref": "#/$defs/maximumRule"},
        "texture_dimension": {"$ref": "#/$defs/dimensionRule"}
      }
    }
  },
  "$defs": {
    "severity": {"enum": ["info", "warning", "error"]},
    "allowedValuesRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "allowed_values", "severity"], "properties": {"enabled": {"type": "boolean"}, "allowed_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "severity": {"$ref": "#/$defs/severity"}}},
    "stateRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "expected", "severity"], "properties": {"enabled": {"type": "boolean"}, "expected": {"enum": ["enabled", "disabled", "any"]}, "severity": {"$ref": "#/$defs/severity"}}},
    "booleanRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "required", "severity"], "properties": {"enabled": {"type": "boolean"}, "required": {"type": "boolean"}, "severity": {"$ref": "#/$defs/severity"}}},
    "maximumRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "max_count", "severity"], "properties": {"enabled": {"type": "boolean"}, "max_count": {"type": "integer", "minimum": 1}, "severity": {"$ref": "#/$defs/severity"}}},
    "dimensionRule": {"type": "object", "additionalProperties": false, "required": ["enabled", "max_size", "severity"], "properties": {"enabled": {"type": "boolean"}, "max_size": {"type": "integer", "minimum": 1}, "severity": {"$ref": "#/$defs/severity"}}}
  }
}
