{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unreal-static-mesh-profile@2.0.0",
  "title": "Unreal Static Mesh Audit Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "rules"],
  "properties": {
    "schema_version": { "const": "unreal-static-mesh-profile@2.0.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangle_budget", "vertex_budget", "material_slots", "lod_count", "nanite", "simple_collision", "lightmap_uv", "lightmap_resolution"],
      "properties": {
        "triangle_budget": { "$ref": "profile.v1.schema.json#/$defs/lod0Limit" },
        "vertex_budget": { "$ref": "profile.v1.schema.json#/$defs/lod0Limit" },
        "material_slots": { "$ref": "profile.v1.schema.json#/$defs/countLimit" },
        "lod_count": { "$ref": "profile.v1.schema.json#/$defs/countMinimum" },
        "nanite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "expected", "severity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "expected": { "enum": ["enabled", "disabled", "any"] },
            "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
          }
        },
        "simple_collision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "min_primitive_count", "allow_complex_as_simple", "severity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "min_primitive_count": { "type": "integer", "minimum": 0 },
            "allow_complex_as_simple": { "type": "boolean" },
            "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
          }
        },
        "lightmap_uv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "required", "min_uv_channel_count", "severity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "required": { "type": "boolean" },
            "min_uv_channel_count": { "type": "integer", "minimum": 1 },
            "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
          }
        },
        "lightmap_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "min_resolution", "severity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "min_resolution": { "type": "integer", "minimum": 1 },
            "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
          }
        }
      }
    }
  }
}
