{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unreal-static-mesh-profile@3.0.0",
  "title": "Unreal Static Mesh Audit Profile v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "rules"],
  "properties": {
    "schema_version": { "const": "unreal-static-mesh-profile@3.0.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangle_budget", "vertex_budget", "material_slots", "lod_count", "nanite",
        "simple_collision", "lightmap_uv", "lightmap_resolution", "missing_materials",
        "unique_materials", "texture_dependencies", "texture_dimension"
      ],
      "properties": {
        "triangle_budget": { "$ref": "profile.v1.schema.json#/$defs/lod0Limit" },
        "vertex_budget": { "$ref": "profile.v1.schema.json#/$defs/lod0Limit" },
        "material_slots": { "$ref": "profile.v1.schema.json#/$defs/countLimit" },
        "lod_count": { "$ref": "profile.v1.schema.json#/$defs/countMinimum" },
        "nanite": { "$ref": "profile.v2.schema.json#/properties/rules/properties/nanite" },
        "simple_collision": { "$ref": "profile.v2.schema.json#/properties/rules/properties/simple_collision" },
        "lightmap_uv": { "$ref": "profile.v2.schema.json#/properties/rules/properties/lightmap_uv" },
        "lightmap_resolution": { "$ref": "profile.v2.schema.json#/properties/rules/properties/lightmap_resolution" },
        "object_name": { "$ref": "profile.v2.schema.json#/properties/rules/properties/object_name" },
        "package_path": { "$ref": "profile.v2.schema.json#/properties/rules/properties/package_path" },
        "missing_materials": { "$ref": "#/$defs/zeroCountLimit" },
        "unique_materials": { "$ref": "profile.v1.schema.json#/$defs/countLimit" },
        "texture_dependencies": { "$ref": "profile.v1.schema.json#/$defs/countLimit" },
        "texture_dimension": { "$ref": "#/$defs/sizeLimit" }
      }
    }
  },
  "$defs": {
    "zeroCountLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_missing_slots", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_missing_slots": { "type": "integer", "minimum": 0 },
        "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
      }
    },
    "sizeLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_size", "severity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_size": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "profile.v1.schema.json#/$defs/severity" }
      }
    }
  }
}
