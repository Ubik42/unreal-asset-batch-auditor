{
  "schema_version": "unreal-material-profile@1.0.0",
  "profile_id": "default-material-delivery-v1",
  "profile_version": "1.0.0",
  "description": "复制到项目后由 TA 与渲染负责人共同评审；这里的阈值仅是格式示例。",
  "rules": {
    "allowed_domains": {"enabled": true, "allowed_values": ["MD_Surface"], "severity": "error"},
    "allowed_blend_modes": {"enabled": true, "allowed_values": ["BLEND_Opaque", "BLEND_Masked"], "severity": "warning"},
    "two_sided": {"enabled": true, "expected": "disabled", "severity": "warning"},
    "instance_parent": {"enabled": true, "required": true, "severity": "error"},
    "parent_depth": {"enabled": true, "max_count": 2, "severity": "warning"},
    "texture_dependencies": {"enabled": true, "max_count": 8, "severity": "warning"},
    "texture_dimension": {"enabled": true, "max_size": 4096, "severity": "error"}
  }
}
